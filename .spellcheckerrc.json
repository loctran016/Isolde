{
  "files": [
    "content/**/*.md",
    "!node_modules/**",
    "!.nuxt/**",
    "!.output/**",
    "!.content/**",
    "!.vercel/**",
    "!audio-store/**",
    "!tts-out/**"
  ],
  "language": "vi-VN",
  "plugins": ["spell", "repeated-words", "syntax-mentions", "syntax-urls"],
  "dictionaries": ["./dictionary/medical_term.txt"],
  "ignore": [
    "[A-Z0-9]{2,}s?",
    "[a-z]+[A-Z][A-Za-z0-9]*",
    "[A-Za-z0-9]+_[A-Za-z0-9_]+",
    "v?[0-9]+(\\.[0-9]+)+[a-z]*",
    "[0-9a-f]{7,}"
  ],
  "noSuggestions": false
}
